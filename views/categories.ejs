<%- include("partials/header") %>

    <section class="page-header">

        <h1>
            <%= title %>
        </h1>

        <p>
            Explore service projects by category.
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/new-category" class="btn">
                    Add New Category
                </a>
            </p>
            <% } %>

    </section>

    <section class="content-section">

        <div class="card-grid">

            <% categories.forEach(category=> { %>

                <article class="card">

                    <h2>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </h2>

                    <% if (category.description) { %>
                        <p>
                            <%= category.description %>
                        </p>
                        <% } %>

                            <p>
                                <a href="/edit-category/<%= category.category_id %>" class="btn">
                                    Edit Category
                                </a>
                            </p>

                </article>

                <% }) %>

        </div>

    </section>

    <%- include("partials/footer") %>