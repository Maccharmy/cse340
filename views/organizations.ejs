<%- include("partials/header") %>

    <section class="page-header">
        <h1>
            <%= title %>
        </h1>
        <p>
            Discover organizations where you can serve and make a difference.
        </p>
    </section>

    <section class="content-section">
        <div class="card-grid">

            <article class="card organization-card">
                <img src="/images/community.jpg" alt="Volunteers working together in a community" loading="lazy">

                <div class="card-content">
                    <h2>Community Partners</h2>
                    <p>
                        Organizations working to improve local communities through
                        service and volunteer opportunities.
                    </p>
                </div>
            </article>

            <article class="card organization-card">
                <img src="/images/education.jpg" alt="Students participating in an educational activity" loading="lazy">

                <div class="card-content">
                    <h2>Education Partners</h2>
                    <p>
                        Organizations providing educational support and learning
                        opportunities.
                    </p>
                </div>
            </article>

            <article class="card organization-card">
                <img src="/images/health.jpg" alt="Health professionals helping members of a community" loading="lazy">

                <div class="card-content">
                    <h2>Health Partners</h2>
                    <p>
                        Organizations supporting health, wellness, and community
                        care.
                    </p>
                </div>
            </article>

        </div>
    </section>

    <%- include("partials/footer") %>