<%- include("partials/header") %>

    <section class="page-header">
        <h1>
            <%= title %>
        </h1>
        <p>
            Discover organizations where you can serve and make a difference.
        </p>
    </section>

    <section class="content-section">
        <div class="card-grid">
            <% organizations.forEach(org=> { %>
                <article class="card organization-card">
                    <!-- Use the logo filename from the database -->
                    <img src="/images/<%= org.logo %>" alt="<%= org.name %> logo" loading="lazy">

                    <div class="card-content">
                        <h2>
                            <%= org.name %>
                        </h2>
                        <p>
                            <%= org.description %>
                        </p>
                        <p>Contact: <%= org.email %>
                        </p>
                    </div>
                </article>
                <% }) %>
        </div>
    </section>

    <%- include("partials/footer") %>