<%- include("partials/header") %>

    <section class="page-header">

        <h1>
            <%= title %>
        </h1>

        <p>
            Find meaningful service projects and opportunities to help others.
        </p>

    </section>

    <section class="content-section">

        <% if (projects.length===0) { %>

            <p>No upcoming projects available at this time.</p>

            <% } else { %>

                <ul>

                    <% projects.forEach(project=> { %>

                        <li>

                            <%= project.date.toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                                day: 'numeric' }) %>:

                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>

                                (

                                <a href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a>

                                )

                        </li>

                        <% }) %>

                </ul>

                <% } %>

    </section>

    <%- include("partials/footer") %>